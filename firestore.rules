rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para documentos privados de cada usuario registrado (el usuario o el SuperAdmin)
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "gyknova@gmail.com");
    }

    // Reglas para perfiles o convocatorias públicas compartidas y panel súper admin
    match /publicos/{pubId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

