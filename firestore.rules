rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para documentos privados de cada usuario registrado
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para perfiles o convocatorias públicas compartidas y panel súper admin
    match /publicos/{pubId} {
      allow read, get, list: if true;
      allow write, create, update, delete: if request.auth != null;
    }
  }
}
